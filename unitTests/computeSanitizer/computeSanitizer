#!/bin/bash

# Unset all variables at the beginning
unset DEVICES_OUTPUT CLEAN_DEVICES GPUS COMMON_FLAGS TOOLS TIMESTAMP LOG_DIR
unset RESULTS FAILED_TESTS SKIPPED_TESTS GPU TOOL TEST_NAME LOG_FILE EXIT_CODE
unset TOTAL_TESTS FAILED_COUNT SKIPPED_COUNT PASSED_COUNT EXIT_STATUS
unset EXEC EXECS

# Source the environment
source ../../bashrc

# All solver executables to test
EXECS=("momentBasedD3Q19" "momentBasedD3Q27" "isothermalD3Q19" "isothermalD3Q27")

# Check that required executables exist
if notFound "${EXECS[@]}" systemInfo; then
    printf "HERMITELBM_CUDA_DIR is not set or has not been built. Please run \"source bashrc\" in the project directory first\n" >&2
    return 1 2>/dev/null || exit 1
fi

if notFound compute-sanitizer; then
    printf "compute-sanitizer does not exist on the system path. Please make sure that the CUDA toolkit is loaded first\n" >&2
    return 1 2>/dev/null || exit 1
fi

# Run systemInfo and capture its output
DEVICES_OUTPUT=$(systemInfo -devList -quiet)

# Extract the content between { and }; from the line that starts with '{'
DEVICES_LINE=$(printf '%s\n' "$DEVICES_OUTPUT" | sed -n 's/^{\(.*\)};$/\1/p')

# If the line is empty (i.e. "{};") there are no devices
if [ -z "$DEVICES_LINE" ]; then
    GPUS=()
    printf "No GPUs detected by systemInfo. Test execution aborted.\n" >&2
    # Clean up all variables at the end
    unset DEVICES_OUTPUT DEVICES_LINE GPUS COMMON_FLAGS TOOLS TIMESTAMP LOG_DIR
    unset RESULTS FAILED_TESTS SKIPPED_TESTS GPU TOOL TEST_NAME LOG_FILE EXIT_CODE
    unset TOTAL_TESTS FAILED_COUNT SKIPPED_COUNT PASSED_COUNT EXIT_STATUS
    unset EXEC EXECS
    return 1 2>/dev/null || exit 1
else
    # Replace commas with spaces and read into the array
    CLEAN_DEVICES="${DEVICES_LINE//,/ }"
    GPUS=($CLEAN_DEVICES)
fi

# Define common flags
COMMON_FLAGS="--print-limit 1000 --check-bulk-copy=yes --check-device-heap=yes --check-exit-code=yes --racecheck-detect-level=error --racecheck-memcpy-async=yes --racecheck-num-workers=0 --racecheck-report=analysis --check-optix-leaks --check-warpgroup-mma=yes --check-api-memory-access=yes --check-optix --track-unused-memory"

# Define tools to test
TOOLS=("memcheck" "synccheck" "initcheck")

# Create a timestamp for log files
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_DIR="logs/log_$TIMESTAMP"
mkdir -p "$LOG_DIR"

# Arrays to store results
RESULTS=()
FAILED_TESTS=()
SKIPPED_TESTS=()

# Print header using printf
if ! skip_header_footer; then
    printHeader
fi
printf "computeSanitizer:\n"
printf "{\n"
printf "    deviceList: [%s];\n" "${GPUS[*]}"
printf "    Log directory: %s\n" "$LOG_DIR"
printf "\n"

# Run tests for each GPU
for GPU in "${GPUS[@]}"; do
    printf "    GPU %d:\n" "$GPU"
    printf "    {\n"
    for EXEC in "${EXECS[@]}"; do
        printf "        %s:\n" "$EXEC"
        printf "        {\n"
        for TOOL in "${TOOLS[@]}"; do
            TEST_NAME="${EXEC}_${TOOL}"
            LOG_FILE="$LOG_DIR/${TEST_NAME}_GPU${GPU}.log"
            
            printf "            %s:" "$TOOL"
            
            # Clean case and run test, capturing output and exit code
            cleanCase
            compute-sanitizer --tool="$TOOL" $COMMON_FLAGS "$EXEC" -GPU "$GPU" > "$LOG_FILE" 2>&1
            EXIT_CODE=$?
            
            # Store result based on exit code
            case $EXIT_CODE in
                0)
                    RESULTS+=("$TEST_NAME on GPU $GPU: PASS")
                    printf " PASS\n"
                    ;;
                101)
                    RESULTS+=("$TEST_NAME on GPU $GPU: SKIPPED (NO GPU)")
                    SKIPPED_TESTS+=("$TEST_NAME on GPU $GPU")
                    printf " SKIPPED (NO GPU)\n"
                    ;;
                *)
                    RESULTS+=("$TEST_NAME on GPU $GPU: FAIL (exit code: $EXIT_CODE)")
                    FAILED_TESTS+=("$TEST_NAME on GPU $GPU")
                    printf " FAIL (exit code: %d)\n" "$EXIT_CODE"
                    ;;
            esac
        done
        printf "        };\n"
        printf "\n"
    done
    printf "    };\n"
    printf "\n"
done

# Clean up and exit directory
cleanCase
cd ../

# Print summary

# Calculate counts before using them
TOTAL_TESTS=${#RESULTS[@]}
FAILED_COUNT=${#FAILED_TESTS[@]}
SKIPPED_COUNT=${#SKIPPED_TESTS[@]}
PASSED_COUNT=$((TOTAL_TESTS - FAILED_COUNT - SKIPPED_COUNT))

# Only show detailed results if there are failures
if [ $FAILED_COUNT -gt 0 ]; then
    for result in "${RESULTS[@]}"; do
        printf "%s\n" "$result"
    done
    printf "\n"
fi

# Final status
if [ $FAILED_COUNT -eq 0 ]; then
    if [ $SKIPPED_COUNT -eq 0 ]; then
        printf "    All unit tests passed (%d/%d)\n" "$PASSED_COUNT" "$TOTAL_TESTS"
    else
        printf "    All unit tests passed (%d/%d), %d skipped\n" "$PASSED_COUNT" "$TOTAL_TESTS" "$SKIPPED_COUNT"
    fi
    EXIT_STATUS=0
else
    printf "    Some unit tests failed (%d/%d passed, %d skipped)\n" "$PASSED_COUNT" "$TOTAL_TESTS" "$SKIPPED_COUNT"
    printf "\n"
    printf "    Failed tests:\n"
    for test in "${FAILED_TESTS[@]}"; do
        printf "      - %s\n" "$test"
    done
    if [ $SKIPPED_COUNT -gt 0 ]; then
        printf "\n"
        printf "    Skipped tests (no GPU available):\n"
        for test in "${SKIPPED_TESTS[@]}"; do
            printf "      - %s\n" "$test"
        done
    fi
    printf "\n"
    printf "    Check individual log files in: computeSanitizer/%s\n" "$LOG_DIR"
    EXIT_STATUS=1
fi
printf "};\n"

if ! skip_header_footer; then
    printEnd
fi

# Clean up all variables at the end
unset DEVICES_OUTPUT CLEAN_DEVICES GPUS COMMON_FLAGS TOOLS TIMESTAMP LOG_DIR
unset RESULTS FAILED_TESTS SKIPPED_TESTS GPU TOOL TEST_NAME LOG_FILE EXIT_CODE
unset TOTAL_TESTS FAILED_COUNT SKIPPED_COUNT PASSED_COUNT
unset EXEC EXECS

# Use return instead of exit to avoid closing the terminal
[[ "${BASH_SOURCE[0]}" != "${0}" ]] && return $EXIT_STATUS || exit $EXIT_STATUS
