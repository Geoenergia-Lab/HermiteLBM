# --------------------------------------------------------------------------- #
# Tests whether the simulation produces NaN from a known good solution setup  #
# (all executables, all GPUs)                                                 #
# --------------------------------------------------------------------------- #

#!/bin/bash

# Unset all variables at the beginning
unset TIMESTAMP LOG_DIR LOG_FILE EXIT_CODE OVERALL_EXIT_STATUS
unset EXEC EXECS GPU GPUS DEVICES_OUTPUT CLEAN_DEVICES

# Source the environment
source ../../bashrc

# All solver executables to test
EXECS=("momentBasedD3Q19" "momentBasedD3Q27" "isothermalD3Q19" "isothermalD3Q27")

# Check that required executables exist
if notFound "${EXECS[@]}" fieldCalculate systemInfo; then
    printf "HERMITELBM_CUDA_DIR is not set or has not been built. Please run \"source bashrc\" in the project directory first\n" >&2
    return 1 2>/dev/null || exit 1
fi

# Run systemInfo and capture its output
DEVICES_OUTPUT=$(systemInfo -devList -quiet)

# Extract the content between { and }; from the line that starts with '{'
DEVICES_LINE=$(printf '%s\n' "$DEVICES_OUTPUT" | sed -n 's/^{\(.*\)};$/\1/p')

# If the line is empty (i.e. "{};") there are no devices
if [ -z "$DEVICES_LINE" ]; then
    GPUS=()
    printf "No GPUs detected by systemInfo. Test execution aborted.\n" >&2
    # Clean up all variables at the end
    unset DEVICES_OUTPUT DEVICES_LINE GPUS COMMON_FLAGS TOOLS TIMESTAMP LOG_DIR
    unset RESULTS FAILED_TESTS SKIPPED_TESTS GPU TOOL TEST_NAME LOG_FILE EXIT_CODE
    unset TOTAL_TESTS FAILED_COUNT SKIPPED_COUNT PASSED_COUNT EXIT_STATUS
    unset EXEC EXECS
    return 1 2>/dev/null || exit 1
else
    # Replace commas with spaces and read into the array
    CLEAN_DEVICES="${DEVICES_LINE//,/ }"
    GPUS=($CLEAN_DEVICES)
fi

# Print header
if ! skip_header_footer; then
    printHeader
fi
printf "containsNaN:\n"
printf "{\n"

# Create timestamped log directory
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_DIR="logs/log_$TIMESTAMP"
mkdir -p "$LOG_DIR"

printf "    deviceList: [%s];\n" "${GPUS[*]}"
printf "    Log directory: %s\n" "$LOG_DIR"
printf "\n"

OVERALL_EXIT_STATUS=0

# Loop over all GPUs
for GPU in "${GPUS[@]}"; do
    printf "    GPU %d:\n" "$GPU"
    printf "    {\n"

    # Loop over all solver executables
    for EXEC in "${EXECS[@]}"; do
        printf "        %s:\n" "$EXEC"
        printf "        {\n"

        LOG_FILE="$LOG_DIR/${EXEC}_GPU${GPU}_containsNaN.log"

        # Clean case, run simulation, check for NaN
        cleanCase
        $EXEC -GPU "$GPU" >> "$LOG_FILE" 2>&1
        fieldCalculate -calculationType containsNaN -fieldName U -latestTime >> "$LOG_FILE" 2>&1
        EXIT_CODE=$?

        case $EXIT_CODE in
            0)
                printf "            Result: PASS (field U has no NaN)\n"
                ;;
            *)
                printf "            Result: FAIL (field U contains NaN or error, exit code %d)\n" "$EXIT_CODE"
                OVERALL_EXIT_STATUS=1
                ;;
        esac

        cleanCase
        printf "        };\n"
    done
    printf "    };\n"
    printf "\n"
done

cd ..

printf "};\n"
if ! skip_header_footer; then
    printEnd
fi

# Clean up variables
unset TIMESTAMP LOG_DIR LOG_FILE EXIT_CODE
unset EXEC EXECS GPU GPUS DEVICES_OUTPUT CLEAN_DEVICES

# Return overall exit status
[[ "${BASH_SOURCE[0]}" != "${0}" ]] && return $OVERALL_EXIT_STATUS || exit $OVERALL_EXIT_STATUS
